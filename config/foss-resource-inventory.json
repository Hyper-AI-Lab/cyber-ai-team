{
  "schema_version": "1.0",
  "policy": "foss_only",
  "defaults": {
    "cost_model": "free_self_hosted",
    "self_hostable": true,
    "data_sharing_risk": "local_processing_only"
  },
  "python": {
    "aiohttp": "Apache-2.0 AND MIT",
    "aiosqlite": "MIT",
    "alembic": "MIT",
    "asyncpg": "Apache-2.0",
    "click": "BSD-3-Clause",
    "fastapi": "MIT",
    "httpx": "BSD-3-Clause",
    "langchain": "MIT",
    "langchain-community": "MIT",
    "langchain-mistralai": "MIT",
    "langfuse": "MIT",
    "langgraph": "MIT",
    "langsmith": "MIT",
    "litellm": "MIT",
    "mem0ai": "Apache-2.0",
    "openfga-sdk": "Apache-2.0",
    "opentelemetry-api": "Apache-2.0",
    "opentelemetry-exporter-otlp": "Apache-2.0",
    "opentelemetry-sdk": "Apache-2.0",
    "bcrypt": "Apache-2.0",
    "pydantic": "MIT",
    "pydantic-settings": "MIT",
    "pyjwt": "MIT",
    "python-multipart": "Apache-2.0",
    "python-slugify": "MIT",
    "pyyaml": "MIT",
    "qdrant-client": "Apache-2.0",
    "redis": "MIT",
    "rich": "MIT",
    "sqlalchemy": "MIT",
    "starlette": "BSD-3-Clause",
    "temporalio": "MIT",
    "twilio": "MIT",
    "uvicorn": "BSD-3-Clause",
    "websockets": "BSD-3-Clause"
  },
  "node": {
    "@types/node": "MIT",
    "@types/react": "MIT",
    "@types/react-dom": "MIT",
    "autoprefixer": "MIT",
    "clsx": "MIT",
    "eslint": "MIT",
    "eslint-config-next": "MIT",
    "jsdom": "MIT",
    "lucide-react": "ISC",
    "next": "MIT",
    "postcss": "MIT",
    "react": "MIT",
    "react-dom": "MIT",
    "recharts": "MIT",
    "tailwind-merge": "MIT",
    "tailwindcss": "MIT",
    "typescript": "Apache-2.0",
    "vitest": "MIT"
  },
  "docker": [
    {"match": "python:3.12-slim", "license": "Python-2.0", "purpose": "backend build and runtime"},
    {"match": "node:20-alpine", "license": "MIT", "purpose": "owner-console build and runtime"},
    {"match": "cyber-team-core", "license": "MIT", "purpose": "Cyber-Team backend"},
    {"match": "cyber-team-ui", "license": "MIT", "purpose": "Cyber-Team owner console"},
    {"match": "postgres:", "license": "PostgreSQL", "purpose": "control-plane database"},
    {"match": "redis:7-", "license": "BSD-3-Clause", "purpose": "queue and cache; major version is intentionally constrained"},
    {"match": "qdrant/qdrant", "license": "Apache-2.0", "purpose": "vector memory"},
    {"match": "temporalio/", "license": "MIT", "purpose": "durable workflows"},
    {"match": "openpolicyagent/opa", "license": "Apache-2.0", "purpose": "action policy"},
    {"match": "openfga/openfga", "license": "Apache-2.0", "purpose": "authorization"},
    {"match": "keycloak/keycloak", "license": "Apache-2.0", "purpose": "identity"},
    {"match": "langfuse/langfuse", "license": "MIT", "purpose": "LLM observability"},
    {"match": "grafana/grafana", "license": "AGPL-3.0", "purpose": "operations dashboards"},
    {"match": "prom/prometheus", "license": "Apache-2.0", "purpose": "metrics"},
    {"match": "prom/alertmanager", "license": "Apache-2.0", "purpose": "alerts"},
    {"match": "ggml-org/llama.cpp", "license": "MIT", "purpose": "local inference"},
    {"match": "searxng/searxng", "license": "AGPL-3.0", "purpose": "self-hosted research"},
    {"match": "mariadb:", "license": "GPL-2.0", "purpose": "ERPNext database"},
    {"match": "frappe/erpnext", "license": "GPL-3.0", "purpose": "business system of record"},
    {"match": "andrius/asterisk", "license": "GPL-2.0", "purpose": "optional telephony"},
    {"match": "jookies/jasmin", "license": "Apache-2.0", "purpose": "optional SMS gateway"}
  ],
  "hosted_service_exceptions": {
    "langchain-mistralai": {
      "status": "optional_zero_spend_only",
      "data_sharing_risk": "configured provider receives prompts",
      "automatic_paid_usage": false
    },
    "langsmith": {
      "status": "optional_disabled",
      "data_sharing_risk": "hosted tracing would receive telemetry",
      "automatic_paid_usage": false
    },
    "twilio": {
      "status": "optional_disabled",
      "data_sharing_risk": "provider receives communication metadata/content",
      "automatic_paid_usage": false
    }
  }
}
